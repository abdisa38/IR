# Ilillii Bar & Restaurant - Backend Environment Configuration
PORT=5000
NODE_ENV=production

# MongoDB connection URI (required)
MONGODB_URI=

# CORS allowed origins (comma-separated exact origins; leave empty for same-origin)
CORS_ORIGIN=*

# JWT secret (required; use a unique random value of at least 32 characters)
JWT_SECRET=

# Google OAuth client ID required for Google sign-in
GOOGLE_CLIENT_ID=
